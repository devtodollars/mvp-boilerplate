# Copied to supabase/.env.local by tests/start-stack.sh (that file is gitignored).
# Secrets for `supabase functions serve` during local testing.

# Stripe TEST-mode secret key (sk_test_…). Never a live key.
# Get it from: stripe config --list --project-name devtodollars
# With the placeholder, Stripe-API tests are skipped and everything else runs.
# Stripe 23 throws on import if this is empty, so keep a placeholder.
STRIPE_SECRET_KEY=sk_test_placeholder_until_real_key

# Any string works locally: the e2e suite signs its own webhook payloads with it.
# If you also run `pnpm stripe:listen`, use the whsec_ it prints instead and set
# the same value in nextjs/.env.test.local as STRIPE_WEBHOOK_SIGNING_SECRET.
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_local_e2e_secret_do_not_use_in_prod

# Optional: leave empty locally.
POSTHOG_CLIENT_KEY=
LOOPS_API_KEY=
